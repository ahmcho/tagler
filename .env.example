APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
APP_PORT=8000
DB_HOST=tagler-cms-postgres
DB_PORT=5432
DB_DATABASE=tagler_cms
DB_USERNAME=tagler
DB_PASSWORD=
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=5173
# App container IP. Vite writes this address into public/hot, so it must be reachable from the browser.
VITE_DEV_SERVER_HMR_HOST=172.60.0.10
MONGODB_USERNAME=tagler
MONGODB_PASSWORD=
MONGODB_HOST=tagler-cms-mongo
MONGODB_PORT=27017
MONGODB_DATABASE=tagler_cms
MONGODB_AUTH_DATABASE=admin
REVERB_APP_ID=tagler-cms
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=tagler-cms-reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=172.60.0.13
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Internal /24 for this stack. Must not overlap any other Docker network or LAN.
NETWORK_SUBNET=172.60.0.0/24
# First three octets of NETWORK_SUBNET. Services get fixed addresses .10 to .16.
NETWORK_PREFIX=172.60.0
# Host ports published on 127.0.0.1-free bindings; change if a port is taken.
APP_HOST_PORT=8100
VITE_HOST_PORT=5173
REVERB_HOST_PORT=8180
POSTGRES_HOST_PORT=5434
MONGO_HOST_PORT=27019

PGADMIN_HOST_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
