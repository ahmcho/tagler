{
    "name": "tagler/crud",
    "description": "Repository, service and request layer for CRUD operations.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Crud\\": "src/"
        }
    },
    "require": {
        "php": "^8.4",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Crud\\Providers\\CrudServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
