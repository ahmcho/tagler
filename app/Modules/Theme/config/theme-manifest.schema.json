{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Tagler theme manifest, schema version 1",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "name", "slug", "version", "requires", "frontend", "templates"],
    "properties": {
        "$schema": { "type": "string", "maxLength": 300 },
        "schema_version": { "const": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
        "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "description": { "type": "string", "maxLength": 500 },
        "author": { "type": "string", "maxLength": 100 },
        "license": { "type": "string", "maxLength": 50 },
        "requires": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tagler", "php"],
            "properties": {
                "tagler": { "type": "string", "pattern": "^\\^[0-9]+\\.[0-9]+$" },
                "php": { "type": "string", "pattern": "^\\^[0-9]+\\.[0-9]+$" }
            }
        },
        "frontend": {
            "type": "object",
            "additionalProperties": false,
            "required": ["framework", "entry"],
            "properties": {
                "framework": { "const": "react" },
                "entry": { "const": "resources/js/index.tsx" }
            }
        },
        "templates": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "patternProperties": {
                "^[a-z][a-z0-9.-]*$": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/-]{0,99}$" }
            }
        }
    }
}
